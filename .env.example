# `npm run setup` copies this file to .env. .env is ignored by git and never sent to the browser.

# Needed for real analysis (the supplied example works without it). Get one at https://console.anthropic.com/ (API keys);
# usage is billed to that account. You can leave this unset: the page asks for the key once and writes it here itself.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional. Which model writes the readings. Chosen under Controls → App and files, which writes these lines; or set
# them here and restart. Default: Claude Sonnet 5.5. Listed there: claude-sonnet-5-5 (default), claude-opus-5-5
# (about twice Sonnet's price), claude-fable-5-1 (about five times); any other Claude model id works too.
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Or any service that speaks the OpenAI-compatible chat API: OpenRouter (https://openrouter.ai/api/v1, models from many
# companies with one key), OpenAI (https://api.openai.com/v1), Groq, Together, or Ollama on this computer
# (http://localhost:11434/v1, no key). Plain http is accepted only for this computer; an address with ?query or #part
# is not accepted. The key is sent only to the address in OPENAI_API_KEY_FOR (the page writes it with the key); with
# that line empty, only to OPENAI_BASE_URL as saved beside it.
# MODEL_PROVIDER=openai-compatible
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=
# OPENAI_API_KEY_FOR=
# OPENAI_MODEL=   (a model id the service offers; Controls → List its models shows them)

# Optional. Largest reply the model may write per request. Default 16000. (Sent as max_completion_tokens to
# api.openai.com, as max_tokens to every other service.)
# ANTHROPIC_MAX_TOKENS=16000

# Optional. Dry-run mode: no key, no bill, canned placeholder answers labelled MOCK. Only for trying the workflow or running tests.
# DEFLATE_MOCK_AI=1

# Optional. Where runs are stored. Default: the data/ folder inside this project.
# DATA_DIR=./data

# Optional. Port and bind address. The server binds to 127.0.0.1 (this computer only) unless you change HOST.
# PORT=3123
# HOST=127.0.0.1

# ---- Research (Search sources on a claim). All optional; the search works without any of these. ----

# Recommended. Sent to Crossref and PubMed as the contact for this tool. Crossref puts requests with a contact address
# in its "polite" pool, which is faster and more reliable; without it you share the anonymous pool.
# RESEARCH_CONTACT_EMAIL=you@example.org

# Optional. OpenAlex (250M+ works, open-access links). Free key at https://openalex.org/ (account → API key). Without a key
# OpenAlex is skipped and the search records "no OPENALEX_API_KEY configured" as an attempt. Free tier has a daily budget.
# OPENALEX_API_KEY=

# Optional. NCBI (PubMed) key: raises the rate limit from 3 to 10 requests/second. Free at https://www.ncbi.nlm.nih.gov/account/
# NCBI_API_KEY=

# Optional. News coverage comes from GDELT (free, no key, one request every 5 seconds). By default only english-language
# outlets are searched; set another language name GDELT knows (e.g. german, spanish) or leave it blank for every language.
# NEWS_LANGUAGE=english

# Optional. Dry-run research: no network, canned candidates labelled MOCK (one with a retraction notice; a news one when
# news coverage is asked for). For tests only.
# DEFLATE_MOCK_RESEARCH=1

# ---- Transcripts for podcast and video links (the intake box fetches them itself). All optional. ----

# When an episode publishes no transcript anywhere the app can look, its audio can be transcribed. The page asks once
# which engine to use and remembers it here: local (Whisper in pure JavaScript, free, slow, nothing leaves this
# computer; installed into data/local-transcription on request) or cloud (Deepgram, fast, paid, audio sent to Deepgram).
# TRANSCRIBE_PREFER=local

# Deepgram key for cloud transcription (https://console.deepgram.com). The page can save it here for you.
# DEEPGRAM_API_KEY=

# Speech model for local transcription (a Transformers.js Whisper model id). base.en is 76 MB and English-only;
# onnx-community/whisper-small.en is more accurate and about three times slower; onnx-community/whisper-base handles
# other languages.
# TRANSCRIBE_MODEL=onnx-community/whisper-base.en

# yt-dlp makes YouTube captions reliable (brew install yt-dlp). If it is not on the PATH, give its location here.
# YTDLP_PATH=/opt/homebrew/bin/yt-dlp

